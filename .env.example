# Environment Variables Example
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# MongoDB Configuration
MONGODB_URI=mongodb://admin:P%40ssW0rd@localhost:27017
DB_MAX_CONNECTIONS=10
DB_CONNECTION_TIMEOUT=5000

# CORS Configuration
CORS_ORIGIN=*

# Logging Configuration
LOG_MAX_FILES=14d
LOG_MAX_SIZE=20m
LOG_DATE_PATTERN=YYYY-MM-DD
LOG_ZIPPED_ARCHIVE=true
LOG_AUDIT_FILE=logs/audit.json
LOG_LEVEL=info

# Syslog Configuration
SYSLOG_ENABLED=false
SYSLOG_HOST=localhost
SYSLOG_PORT=514
SYSLOG_PROTOCOL=udp4
SYSLOG_FACILITY=local0
SYSLOG_APP_NAME=bun-elysia

# Rate Limiting Configuration
RATE_LIMIT_ENABLED=true

# General Rate Limit (applied to all endpoints)
RATE_LIMIT_GENERAL_DURATION=60000
RATE_LIMIT_GENERAL_MAX_PROD=100
RATE_LIMIT_GENERAL_MAX_DEV=1000

# API Rate Limit (applied to /api/v1/* endpoints)
RATE_LIMIT_API_DURATION=60000
RATE_LIMIT_API_MAX_PROD=200
RATE_LIMIT_API_MAX_DEV=500

# Auth Rate Limit (applied to /api/v1/auth/* endpoints)
RATE_LIMIT_AUTH_DURATION=60000
RATE_LIMIT_AUTH_MAX_PROD=5
RATE_LIMIT_AUTH_MAX_DEV=20

# Sensitive Operations Rate Limit
RATE_LIMIT_SENSITIVE_DURATION=300000
RATE_LIMIT_SENSITIVE_MAX_PROD=3
RATE_LIMIT_SENSITIVE_MAX_DEV=10